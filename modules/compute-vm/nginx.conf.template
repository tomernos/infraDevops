# NGINX config for SweptLock VM
# Rendered at boot via: envsubst '${PRIVATE_BIND_IP}' < nginx.conf.template > /etc/nginx/conf.d/sweptlock.conf
#
# Two server blocks:
#   1. Public (0.0.0.0:80)  — main backend proxy
#   2. Private ($PRIVATE_BIND_IP:80) — platform panel + platform-api
#
# PRIVATE_BIND_IP is set at runtime from Secret Manager.
# Examples:
#   100.x.x.x  → Tailscale
#   10.0.0.1   → WireGuard / GCP VPC subnet
#   127.0.0.1  → local dev

# ── Public block ─────────────────────────────────────────────────────────────
server {
    listen 80 default_server;

    location /health {
        proxy_pass         http://sweptlock-api:4000/health;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass         http://sweptlock-api:4000;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
}

# ── Private block (platform) ──────────────────────────────────────────────────
# Only reachable from ${PRIVATE_BIND_IP} — private network (Tailscale/WireGuard/VPC).
# The public block above does NOT proxy here; these are entirely separate bindings.
server {
    listen ${PRIVATE_BIND_IP}:8080;

    # Platform panel SPA
    location / {
        proxy_pass       http://platform-panel:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Platform API
    location /api/ {
        proxy_pass       http://platform-api:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }
}
